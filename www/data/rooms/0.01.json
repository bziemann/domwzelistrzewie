, [0, -22, 181.5, -22, "181,5", 1], [203.5, 0, 203.5, 93, "D03 93", 1], [160, 236, 181.5, 236, "21,5", 1], [60, 236, 160, 236, "przejście 100", 1], [-22, 263.5, -22, 356, "D01", -1], [62.5, 416, 160, 416, "DZ1 97,5", 1]], "info": [["Wiatrołap", "181,5 × 368 cm wg modelu (architekt: 183 × 375, 6,86 m²)"], ["Wysokość", "279 cm"], ["Drzwi", "DZ1 wejściowe na zewnątrz; D01 z garażu i D03 loftowe do korytarza otwierane do wiatrołapu"], ["Obudowa", "wzdłuż ściany z łazienką, przyjęte 21,5 cm (do ościeża DZ1), do zmierzenia"], ["Posadzka", "panel dębowy, ogrzewanie podłogowe, wycieraczka wpuszczana przy DZ1"]], "items": {"common": [{"id": "mirror", "s": "Lustro", "name": "Lustro na całą wysokość 60 × 190", "x0": 158, "x1": 160, "z0": 150, "z1": 210, "h": "15–205 cm", "along": "z", "solid": true, "note": "Na obudowie naprzeciw szafy, bez ramy, klejone do płyty. Widać w nim całą sylwetkę z odległości 100 cm. Jasne światło z dwóch opraw po bokach, bez cienia na twarzy."}, {"id": "shelf", "s": "Półka", "name": "Półka na klucze i pocztę", "x0": 146, "x1": 160, "z0": 282, "z1": 342, "h": "100 cm", "along": "z", "solid": true, "note": "Dąb, 14 cm głębokości, zaraz przy drzwiach wejściowych po stronie klamki. Nad nią gniazdo z USB do ładowania telefonu."}, {"id": "mat", "s": "Wycieraczka", "name": "Wycieraczka wpuszczana 97,5 × 60", "x0": 62.5, "x1": 160, "z0": 306, "z1": 366, "h": "w poziomie posadzki", "along": "x", "floor": true, "note": "Ramka aluminiowa w posadzce, wkład ryflowany lub szczotkowy. Zbiera piasek i wodę przed panelami. Wnęka do zaplanowania przed wylewką."}], "A": [{"id": "wardrobe", "s": "Szafa", "name": "Szafa przesuwna 258 × 60", "x0": 0, "x1": 60, "z0": 0, "z1": 258, "h": "do sufitu 279 cm", "along": "z", "solid": true, "note": "Trzy fronty po 86 cm na dwóch torach, białe matowe. Od korytarza: długie płaszcze, środek z niskim drążkiem dla dziecka (125 cm), przy wejściu buty. W każdej części dwie półki na buty na dole (ok. 30 par), półka górna na czapki i rękawiczki."}], "B": [{"id": "bench", "s": "Ławka", "name": "Ławka z wieszakami 68 × 44", "x0": 0, "x1": 44, "z0": 0, "z1": 68, "h": "siedzisko 47 cm", "along": "z", "solid": true, "note": "Siedzisko dębowe, w środku półka na buty. Nad ławką wieszaki dla gości (160 cm), niżej dwa wieszaki dla dziecka (107 cm) i półka na 190 cm."}, {"id": "wardrobe", "s": "Szafa", "name": "Szafa przesuwna 190 × 60", "x0": 0, "x1": 60, "z0": 68, "z1": 258, "h": "do sufitu 279 cm", "along": "z", "solid": true, "note": "Dwa fronty po 95 cm, białe matowe. Część od ławki z niskim drążkiem dla dziecka, część od wejścia na płaszcze. Na dole półki na buty (ok. 20 par)."}]}}, "points": [{"id": "w1", "k": "W", "c": "sw", "name": "Włącznik podwójny: światło wiatrołapu (schodowy) / oświetlenie zewnętrzne", "x": 160, "z": 355, "h": "100 cm", "loc": "Obudowa przy DZ1, po stronie klamki", "ox": -14, "note": "Światło włącza też czujnik ruchu. Klawisz 2: lampy przed wejściem."}, {"id": "w2", "k": "W", "c": "sw", "name": "Włącznik schodowy światła wiatrołapu", "x": 160, "z": 104, "h": "100 cm", "loc": "Obudowa przy D03, po stronie klamki", "ox": -14, "note": "Para z w1. Przez szkło loftowych drzwi widać, czy w wiatrołapie świeci."}, {"id": "m1", "k": "R", "c": "ctl", "name": "Czujnik ruchu (sufitowy)", "x": 100, "z": 200, "h": "sufit", "loc": "Środek wiatrołapu", "note": "Włącza obie oprawy po wejściu z zewnątrz i z garażu, gasi po ok. 2 min. Czujnik zmierzchu: w dzień nie zapala."}, {"id": "i1", "k": "D", "c": "ctl", "name": "Panel wideodomofonu", "x": 160, "z": 330, "h": "150 cm", "loc": "Obudowa, obok półki na klucze", "ox": -14, "note": "Puszka podtynkowa, przewód do stacji bramowej i zasilacza w szafce teletechnicznej."}, {"id": "a1", "k": "A", "c": "ctl", "name": "Manipulator alarmu", "x": 160, "z": 262, "h": "150 cm", "loc": "Obudowa, między lustrem a domofonem", "ox": -14, "note": "Wejściem z garażu i drzwiami frontowymi przechodzi się obok niego."}, {"id": "t1", "k": "T", "c": "ctl", "name": "Termostat ogrzewania podłogowego", "x": 160, "z": 128, "h": "150 cm", "loc": "Obudowa, między D03 a lustrem", "ox": -14, "note": "Z czujnikiem podłogi: panele mają ograniczenie temperatury powierzchni (zwykle 27°C)."}, {"id": "g1", "k": "G", "c": "sock", "name": "Gniazdo podwójne z USB", "x": 160, "z": 296, "h": "115 cm", "loc": "Nad półką na klucze", "ox": -14, "oz": 0, "note": "Ładowanie telefonu przy wyjściu."}, {"id": "g2", "k": "G", "c": "sock", "name": "Gniazdo", "x": 160, "z": 230, "h": "30 cm", "loc": "Obudowa, za lustrem w stronę wejścia", "ox": -14, "note": "Odkurzacz, suszarka do butów zimą."}, {"id": "p1", "k": "Z", "c": "pow", "name": "Zasilanie oświetlenia LED w szafie", "x": 30, "z": 248, "h": "pod sufitem, nad szafą", "loc": "Ściana od garażu, nad szafą", "ox": 14, "note": "Taśma LED przy drążkach, włączana czujnikiem w torze drzwi."}, {"id": "p2", "k": "Z", "c": "pow", "name": "Zasilanie zamka elektronicznego DZ1", "x": 158, "z": 368, "h": "w ościeżnicy", "loc": "Ościeże DZ1 od strony zamka", "ox": -40, "oz": -12, "note": "Przewód 12/24 V i sygnałowy do ościeżnicy przed montażem drzwi. Nawet jeśli zamek elektroniczny dojdzie później."}, {"id": "c1", "k": "L", "c": "light", "name": "Oprawa sufitowa", "x": 82, "z": 110, "h": "sufit 279 cm", "loc": "Przy D03 i szafie", "note": "Płaska, ok. 1000 lm, 3000 K. Dwie oprawy równo oświetlają szafę i lustro."}, {"id": "c2", "k": "L", "c": "light", "name": "Oprawa sufitowa", "x": 82, "z": 280, "h": "sufit 279 cm", "loc": "Przy wejściu", "note": "Jak c1."}, {"id": "v1", "k": "V", "c": "vent", "name": "Wywiew rekuperacji", "x": 110, "z": 40, "h": "sufit", "loc": "Przy szafie, od strony korytarza", "note": "Ok. 15–20 m³/h. Wyciąga zapach butów i wilgoć z mokrych kurtek. Nawiewu tu nie ma: powietrze dopływa z korytarza."}], "lights": [{"id": "c1", "kind": "ceiling", "at": [82, 279, 110], "r": 16}, {"id": "c2", "kind": "ceiling", "at": [82, 279, 280], "r": 16}], "notes": [{"t": "Wymiary pomieszczenia", "items": ["Wiatrołap 181,5 × 368 cm wg modelu (architekt: 183 × 375, 6,86 m²), wysokość 279 cm, bez okna.", "Wzdłuż ściany z łazienką 0.10 obudowa zakończona krótką ścianką przy drzwiach do korytarza. Wg Błażeja ok. 25 cm; w modelu 21,5 cm, bo przy 25 cm wchodziłaby 3,5 cm w otwór drzwi wejściowych.", "Drzwi wejściowe DZ1 (otwór 97,5) otwierane na zewnątrz, zawias od strony garażu.", "Drzwi z garażu D01 (92,5) przy ścianie frontowej, otwierane do wiatrołapu jak na rysunku architekta.", "Drzwi do korytarza D03 (93) przy ścianie od pokoju gościnnego, otwierane do wiatrołapu."]}, {"t": "Decyzje", "items": ["Drzwi do korytarza szklane, loftowe: czarna stal, szkło bezpieczne, podział 3 × 2. Wpuszczają do wiatrołapu światło z domu.", "Szafa przesuwna do sufitu na ścianie od garażu, 60 cm głębokości. Zostaje 100 cm przejścia do obudowy.", "Lustro 60 × 190 na obudowie naprzeciw szafy.", "Wariant A: szafa 258 cm, ok. 30 par butów. Wariant B: szafa 190 cm + ławka 68 cm z wieszakami dla gości i dziecka.", "Wózek, hulajnogi i rowerki poza wiatrołapem (garaż).", "Wycieraczka wpuszczana w posadzkę przy DZ1.", "Dwie oprawy sufitowe z czujnikiem ruchu, włączniki schodowe przy obu drzwiach. Domofon, alarm i termostat na obudowie.", "Ogrzewanie podłogowe, wywiew z rekuperacji, bez klimatyzacji.", "Fronty białe matowe (do zmiany na dekor drewna, jeśli Błażej woli)."]}, {"t": "Do sprawdzenia przed zamówieniem", "warn": true, "items": ["Zmierzyć obudowę: jeśli ma pełne 25 cm, przejście przy szafie spada do 96,5 cm, a obudowa styka się z ościeżem DZ1.", "Drzwi loftowe: szkło hartowane lub laminowane (ESG/VSG), bo to strefa przejścia. Próg i uszczelka niepotrzebne.", "Drzwi z garażu: szczelne, z uszczelką i samozamykaczem, zalecane EI30. Spaliny i zapach z garażu nie mogą wchodzić do domu.", "Skrzydło D01 otwarte zachodzi na przejście przy szafie. Alternatywa: drzwi z garażu otwierane do garażu, jeśli pozwala na to miejsce przy samochodzie.", "Wnęka pod wycieraczkę: zaplanować przed wylewką (ok. 2 cm głębiej niż reszta).", "Panele przy wejściu: listwa progowa przy DZ1 i silikon przy ramie wycieraczki."]}, {"t": "Instalacje i budowa", "items": ["Szczegóły punktów: widok Instalacje.", "Wzmocnienia w ścianie od garażu pod szafę i ławkę z wieszakami; płyta pod lustro na obudowie.", "Przewody do domofonu, alarmu i zamka DZ1 przed tynkami."]}]}